+import numpy as np, colorsys
+
+def _avoid_near_white(colors, max_luma=0.85, min_sat=0.6, max_val=0.8):
+    """colors: list of RGB (0-1或0-255都可); 返回0-1 RGB"""
+    out = []
+    for c in colors:
+        # 统一到 0~1
+        rgb = np.array(c, dtype=float)
+        if rgb.max() > 1.0: rgb = rgb / 255.0
+
+        # 线性亮度（更稳）：Y = 0.2126 R + 0.7152 G + 0.0722 B
+        Y = 0.2126*rgb[0] + 0.7152*rgb[1] + 0.0722*rgb[2]
+
+        if Y > max_luma:  # 认为“太白/太亮”
+            h, s, v = colorsys.rgb_to_hsv(*rgb)
+            s = max(s, min_sat)    # 提高饱和度
+            v = min(v, max_val)    # 压低明度
+            rgb = np.array(colorsys.hsv_to_rgb(h, s, v), dtype=float)
+
+        out.append(tuple(rgb.tolist()))
+    return out
+
